[worldserver]

########################################
# mod-playerbot-autonomy
########################################

# Activity switch; OFF stops new enrollment/director work.
# Persistence protection is mandatory while this module is installed, including
# Enable=0, reload and restart. Both enrollment migrations and the matching
# playerbots maintenance v1 capability are required even when activities are off.
# Missing capability aborts; DB/cache failure blocks destructive maintenance.
# Known unowned filler resumes legacy maintenance after startup reconciliation.
# There is no runtime switch that exposes Pending/Persistent characters to reset.
# Rollback must retain this protection or keep the realm stopped. Preserve SQL.
PlayerbotAutonomy.Enable = 0

# Explicit console/administrator-RA interrupted-founding recovery only. See
# docs/GUILD_FOUNDING_RECOVERY.md. Diagnostics do not require this write gate.
PlayerbotAutonomy.AllowGuildRecoveryCommands = 0

# Separate operator authorization switch for the stage/confirm/cancel/retire
# CLI/RA/SOAP commands. 0 is the safe default even if protection is enabled.
# Authenticated administrators only; never expose these mutations to players.
# Read-only autonomy status/diagnose do not require this switch. Diagnosis requires
# administrator-only RA admission (Ra.MinLevel >= 3); see docs/RUNTIME_ENROLLMENT.md.
PlayerbotAutonomy.AllowEnrollmentCommands = 0

# Internal world-thread founding. Requires master activities ON and playerbots
# enrollment handoff v1. No existing guild is automatically adopted or deleted.
# Apply the guild migration before enabling, including for dry-run startup audit.
PlayerbotAutonomy.GuildDirector.Enable = 0
# 1 makes automatic director work read-only. Explicit approved recovery uses
# its separate AllowGuildRecoveryCommands write gate; see the recovery runbook.
PlayerbotAutonomy.GuildDirector.DryRun = 1
# 0..64 slots; quarantined/uncertain intents consume their slot until reviewed.
PlayerbotAutonomy.GuildDirector.GuildCount = 8
# Target floor(GuildCount * percent / 100) Alliance intents; fill the missing
# quota using existing immutable intents when increasing the target.
PlayerbotAutonomy.GuildDirector.AlliancePercent = 50
# 1..200; founders count. Over-cap managed guilds are quarantined, never trimmed.
PlayerbotAutonomy.GuildDirector.MaxMembers = 70
# 1..64 GUID candidates per scheduler pass; no per-bot population scans.
PlayerbotAutonomy.GuildDirector.CandidatesPerTick = 16
# 100..60000 ms per controller pass; one managed roster audit (<=200) per pass.
PlayerbotAutonomy.GuildDirector.IntervalMs = 1000
# 1000..86400000 ms between new founding intents. Preparation milestones allow
# 180 seconds, creation visibility 90 seconds, total enabled job cap 600 seconds.
PlayerbotAutonomy.GuildDirector.FoundingCooldownMs = 60000
# WotLK playable class bits: bit(classId-1), excludes unused class 10.
PlayerbotAutonomy.GuildDirector.ClassMask = 1535

# Recruitment into explicitly managed guilds only; no manual enrollment needed.
# Requires activities and GuildDirector.Enable. One active request globally;
# founders count toward MaxMembers. Each AddMember rechecks the complete bounded
# roster, actor rank/rights, character faction/class/control and actual capacity.
PlayerbotAutonomy.Recruitment.Enable = 0
# Parent GuildDirector.DryRun also forces recruitment dry-run.
PlayerbotAutonomy.Recruitment.DryRun = 1
# 1000..86400000 ms between requests, including a fresh delay after restart/reload.
# Candidate budget and scheduler interval inherit GuildDirector settings.
PlayerbotAutonomy.Recruitment.CooldownMs = 15000

# M2 simulated dungeon-party planning. Requires the operations migration even
# when disabled at next boot, so interrupted intents can be cancelled safely.
# Existing managed guild ownership and M1 protection are required. No executor,
# groups, teleports, dungeon entry or rewards are provided by this slice.
PlayerbotAutonomy.Operations.Enable = 0
# Enable=1 with DryRun=1 refreshes read-only capability snapshots/plans only.
# DryRun=0 explicitly permits durable SIMULATED operations and temporary leases.
PlayerbotAutonomy.Operations.DryRun = 1
# Separate future executor gate. Setting 1 currently fails closed with a reason.
PlayerbotAutonomy.Operations.AssembleGroups = 0
PlayerbotAutonomy.Operations.CrossGuild = 0
# 1..4 concurrent simulations. At most one SQL action is scheduled per tick.
PlayerbotAutonomy.Operations.MaxConcurrent = 1
# 1000..60000 ms between planning/state decisions; one bounded decision per pass.
PlayerbotAutonomy.Operations.IntervalMs = 5000
# 1..16 character capability refreshes per second; managed guilds only.
PlayerbotAutonomy.Operations.RefreshPerSecond = 4
# Fixed leases are never renewed. 30..600 timeout; timeout < lease <= 900.
PlayerbotAutonomy.Operations.TimeoutSeconds = 90
PlayerbotAutonomy.Operations.LeaseSeconds = 120
# Conservative generic party template. Item level is the existing playerbots
# equipped average; this does not establish target dungeon access or lockouts.
PlayerbotAutonomy.Operations.MinLevel = 15
PlayerbotAutonomy.Operations.MaxLevel = 80
PlayerbotAutonomy.Operations.LevelSpread = 5
PlayerbotAutonomy.Operations.MinItemLevel = 1
# Evidence older than 5..300 seconds is rejected. Raise refresh throughput before
# raising this bound. At most 512 members cached; capacity overflow fails closed.
PlayerbotAutonomy.Operations.MaxSnapshotAgeSeconds = 30
PlayerbotAutonomy.Operations.MaxCandidates = 512
